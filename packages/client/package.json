{
  "name": "@klymbak/client",
  "version": "0.4.0",
  "description": "Framework-agnostic browser client for @klymbak/server: typed API client, chat store with change notifications, formatting and safe Markdown.",
  "license": "MIT",
  "author": "Ivan Berezhnyk <ivan@berezhnyk.com>",
  "homepage": "https://github.com/klymbak/klymbak/tree/main/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klymbak/klymbak.git",
    "directory": "packages/client"
  },
  "bugs": { "url": "https://github.com/klymbak/klymbak/issues" },
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "@klymbak/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locales/*": {
      "@klymbak/source": "./src/locales/*.ts",
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js"
    },
    "./style.css": "./styles/index.css"
  },
  "files": ["dist", "styles"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@klymbak/protocol": "workspace:*",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2"
  }
}
