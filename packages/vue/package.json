{
  "name": "@klymbak/vue",
  "version": "0.3.0",
  "description": "Vue 3 components for chat-native admin panels: streaming chat, tool cards, approvals, subagent traces, generative UI, model picker, schedules.",
  "license": "MIT",
  "author": "Ivan Berezhnyk <ivan@berezhnyk.com>",
  "homepage": "https://github.com/klymbak/klymbak/tree/main/packages/vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klymbak/klymbak.git",
    "directory": "packages/vue"
  },
  "bugs": { "url": "https://github.com/klymbak/klymbak/issues" },
  "type": "module",
  "sideEffects": ["*.css", "*.vue"],
  "exports": {
    ".": {
      "@klymbak/source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "@klymbak/source": "./src/style.css",
      "default": "./dist/style.css"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@klymbak/client": "workspace:*",
    "@klymbak/protocol": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "vite": "^8.3.0",
    "vue": "^3.5.22",
    "vue-tsc": "^3.1.0"
  }
}
