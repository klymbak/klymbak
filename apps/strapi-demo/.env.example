HOST=0.0.0.0
PORT=1337

# Strapi secrets. Replace every value; `openssl rand -base64 16` makes a good one.
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Models: set at least one key, or run LM Studio / Ollama locally.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# LOCAL_MODELS=false   # true by default: list models running in LM Studio and Ollama
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# AGENT_DEFAULT_MODEL=lmstudio/qwen/qwen3.8-27b

# Optional: an admin token (Settings → Admin tokens) to also give the assistant Strapi's MCP tools.
# KLYMBAK_MCP_TOKEN=
