{
  "name": "acme-api",
  "version": "0.1.0",
  "private": true,
  "description": "Demo: the Acme Outfitters back office, run by an agent instead of an admin panel.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning --conditions=@klymbak/source --env-file-if-exists=.env src/main.ts",
    "start": "tsx --disable-warning=ExperimentalWarning --conditions=@klymbak/source --env-file-if-exists=.env src/main.ts",
    "seed": "tsx --disable-warning=ExperimentalWarning --conditions=@klymbak/source src/db/reset.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@klymbak/server": "workspace:*",
    "carrier-mcp": "workspace:*",
    "hono": "^4.10.4"
  }
}
