# Any provider with a key shows up in the model picker. Set at least one,
# or run LM Studio / Ollama locally.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local models (discovered automatically). Set LOCAL_MODELS=0 to turn off.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Preferred default model(s), comma-separated "provider/model".
AGENT_DEFAULT_MODEL=anthropic/claude-sonnet-5-5,openai/gpt-6.1-sol,google/gemini-3.8-flash

PORT=8787

# Semantic search in the knowledge base, through an embeddings model (keyword search works without one).
# With LM Studio: load text-embedding-nomic-embed-text-v1.5 and set
# KNOWLEDGE_EMBEDDINGS_MODEL=text-embedding-nomic-embed-text-v1.5
# KNOWLEDGE_EMBEDDINGS_URL defaults to LMSTUDIO_BASE_URL.

# Where the database, conversations and knowledge caches live. Default: apps/acme-api/data.
# ACME_DATA_DIR=
