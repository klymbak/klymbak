{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
